NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Yalnızca sunucuda kullanılan güvenli analytics işlemleri için; tarayıcıya NEXT_PUBLIC_ ekleme
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Sunucu tarafında ziyaretçi IP'lerini tuzlamak için rastgele uzun bir metin
ANALYTICS_IP_SALT=change-me-to-a-long-random-string
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/discord/callback
# Presence botu (yalnızca sunucu tarafında kullanılır, NEXT_PUBLIC_ öneki vermeyin)
PRESENCE_API_URL=http://localhost:3001
PRESENCE_API_KEY=change-me-to-a-long-random-string

