# Wispbyte panelinde ortam değişkeni olarak girilir (bu dosyayı canlıya yüklemeyin)
DISCORD_TOKEN=your-bot-token
TARGET_USER_ID=your-discord-user-id
# Opsiyonel: yalnızca sunucu ID'si (17-20 haneli sayı). Boş bırakılırsa botun tüm sunucuları taranır.
GUILD_ID=
PRESENCE_API_KEY=change-me-to-a-long-random-string
# Pterodactyl/Wispbyte genelde PORT veya SERVER_PORT atar; otomatik okunur.
# PORT=3001
